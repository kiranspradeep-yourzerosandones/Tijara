{
  "extends": "expo/tsconfig.base",

  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",

    "moduleResolution": "bundler",

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"]
    },

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,

    "ignoreDeprecations": "6.0"
  },

  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/**/*"
  ],

  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js"
  ]
}